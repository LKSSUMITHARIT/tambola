@page
@model Tambola.Web.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = "Change password"; ViewData["Narrow"] = true; }
<div class="card" style="margin-top:30px">
  <h1>Change password</h1>
  @if (Model.Forced) { <div class="alert">An administrator reset your password. Please choose a new one to continue.</div> }
  <form method="post">
    <label for="Current">@(Model.Forced ? "Temporary password" : "Current password")</label><input asp-for="Current" type="password" autocomplete="current-password">
    <label for="NewPassword">New password</label><input asp-for="NewPassword" type="password" autocomplete="new-password">
    <div class="hint">At least @Model.MinLength characters.</div>
    <label for="Confirm">Confirm new password</label><input asp-for="Confirm" type="password" autocomplete="new-password">
    @if (Model.Error != null) { <div class="alert bad">@Model.Error</div> }
    <div class="row" style="margin-top:16px"><button class="btn primary" type="submit">Change password</button></div>
  </form>
</div>

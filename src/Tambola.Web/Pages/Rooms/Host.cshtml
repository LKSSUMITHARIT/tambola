@page "/Rooms/Host/{code}"
@model Tambola.Web.Pages.Rooms.HostModel
@{ ViewData["Title"] = "Host console"; }
<div id="app" data-code="@Model.Code" data-role="host">
  <div class="row spread">
    <div><h1>@Model.RoomName <span class="badge" id="statusBadge">…</span></h1>
      <p class="sub">Calling: <b id="callLbl"></b> · Cutting: <b id="cutLbl"></b> · <span id="pcount2">0</span> players · Share the code:</p></div>
    <div class="code" id="roomCode">@Model.Code</div>
  </div>
  <div class="alert bad" id="conn" style="display:none">Reconnecting…</div>
  <div class="alert warn" id="banner" style="display:none"></div>

  <div class="cols">
    <div class="grid">
      <div class="card current"><div class="hint">CURRENT NUMBER · <span id="cnt">0</span> / 90 called</div>
        <div class="ball" id="ball">—</div><div class="recent" id="recent"></div>
        <div class="row" style="justify-content:center;margin-top:14px">
          <button class="btn ok" id="start" type="button">▶ Start game</button>
          <button class="btn primary" id="next" type="button" disabled>🎱 Call next</button>
          <div class="pill-toggle" id="cm"><button type="button" data-v="Manual">Manual</button><button type="button" data-v="Auto">Auto</button></div>
          <select id="interval" title="Auto interval (seconds)" style="width:auto"><option>3</option><option>4</option><option>5</option><option selected>6</option><option>8</option><option>10</option><option>15</option></select>
          <button class="btn" id="pause" type="button" disabled>⏸ Pause</button>
          <button class="btn danger" id="end" type="button">■ End game</button></div>
        <p class="hint" style="margin-top:10px">Numbers are announced aloud on this device. Use 🔊 in the header to mute.</p></div>
      <div class="card"><h2>Called numbers</h2><div class="board" id="board"></div></div>
    </div>
    <div class="grid" style="align-self:start">
      <div class="card"><h2>Prizes</h2><div id="prizes"></div></div>
      <div class="card"><h2>Claims &amp; feed</h2><div class="feed" id="feed"></div></div>
      <div class="card"><h2>Players <span class="badge ok" id="pcount">0</span></h2><ul class="list" id="players"></ul>
        <button class="btn sm" id="lock" type="button">🔒 Lock room</button></div>
    </div>
  </div>
</div>
@section Scripts { <script src="~/js/host.js" asp-append-version="true"></script> }

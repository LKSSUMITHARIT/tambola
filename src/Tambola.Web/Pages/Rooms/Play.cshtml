@page "/Rooms/Play/{code}"
@model Tambola.Web.Pages.Rooms.PlayModel
@{ ViewData["Title"] = Model.RoomName; }
<div id="app" data-code="@Model.Code" data-role="player">
  <div class="row spread">
    <div><h1>@Model.RoomName <span class="badge" id="statusBadge">…</span></h1>
      <p class="sub">Host: <span id="hostName"></span> · Calling: <b id="callLbl"></b> · Cutting: <b id="cutLbl"></b> · <span id="cnt">0</span> of 90 called</p></div>
    <div class="row"><div class="code" id="roomCode">@Model.Code</div></div>
  </div>
  <div class="alert bad" id="conn" style="display:none">Reconnecting…</div>
  <div class="alert warn" id="banner" style="display:none"></div>

  <div class="cols">
    <div class="grid">
      <div class="card current" id="currentCard"><div class="hint">CURRENT NUMBER</div>
        <div class="ball" id="ball">—</div><div id="said" class="hint">Waiting for the first call…</div><div class="recent" id="recent"></div></div>
      <div class="card"><div class="row spread"><h2>Your tickets</h2><button class="btn primary sm" id="buy" type="button">➕ Get a ticket</button></div>
        <div id="tix"></div>
        <p class="hint"><span style="color:var(--warn)">■</span> called (tap to cut in manual mode) &nbsp; <span style="color:var(--brand)">■</span> cut</p></div>
    </div>
    <div class="grid" style="align-self:start">
      <div class="card"><h2>Prizes &amp; claims</h2><div id="prizes"></div></div>
      <div class="card"><h2>Called numbers</h2><div class="board" id="board"></div></div>
      <div class="card"><h2>Live feed</h2><div class="feed" id="feed"></div></div>
      <div class="card"><h2>Players <span class="badge ok" id="pcount">0</span></h2><ul class="list" id="players"></ul></div>
    </div>
  </div>

  <div class="overlay" id="win"><div class="modal"><div class="big">🎉</div><h2>Congratulations!</h2><p id="winTxt"></p><button class="btn primary" type="button" data-close="win">Awesome!</button></div></div>
  <div class="overlay" id="late"><div class="modal"><div class="big">⚡</div><h2>So close!</h2><p id="lateTxt"></p><button class="btn primary" type="button" data-close="late">Got it — I'll be quicker</button></div></div>
  <div class="overlay" id="bad"><div class="modal"><div class="big">🤔</div><h2>Not a valid claim yet</h2><p id="badTxt"></p><button class="btn" type="button" data-close="bad">Back to ticket</button></div></div>
</div>
@section Scripts { <script src="~/js/play.js" asp-append-version="true"></script> }

<!doctype html>
@{
  var appOpt = Context.RequestServices.GetRequiredService<Microsoft.Extensions.Options.IOptions<Tambola.Web.Services.AppOptions>>().Value;
  var snd = Context.RequestServices.GetRequiredService<Tambola.Web.Services.SettingsService>().Sound;   // Admin-managed, same for every user
}
<html lang="en" data-default-theme="@appOpt.DefaultTheme.ToLowerInvariant()" data-default-sound="@(snd.Enabled ? "on" : "off")" data-caller="@snd.CallerStyle" data-fallback="@snd.Fallback" data-volume="@snd.Volume" data-allow-mute="@(snd.AllowMute ? "yes" : "no")">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>@(ViewData["Title"] ?? "Tambola")</title>
  <script>
    (function () {
      var r = document.documentElement, t = r.dataset.defaultTheme;
      try { t = localStorage.getItem('theme') || t; } catch (e) { }
      if (t === 'dark' || t === 'light') r.dataset.theme = t;
    })();
  </script>
  <link rel="stylesheet" href="~/css/site.css" asp-append-version="true">
</head>
<body>
@{
  var isAuth = User.Identity?.IsAuthenticated == true;
  var registered = User.HasClaim(c => c.Type == Claims.EmployeeId);
  var path = Context.Request.Path.Value ?? "";
  string On(string p) => path.StartsWith(p, StringComparison.OrdinalIgnoreCase) ? "on" : "";
}
<header class="top">
  <a class="logo" href="/">Tambola <small><i class="chip" style="background:#d9304f">7</i><i class="chip" style="background:#2563eb">5</i><i class="chip" style="background:#f59e0b">9</i></small></a>
  @if (registered)
  {
    <nav>
      <a href="/" class="@(path == "/" ? "on" : "")">🏠 <span class="lbl">Home</span></a>
      @if (User.IsInRole("Host")) { <a href="/Rooms/Create" class="@On("/Rooms/Create")">➕ <span class="lbl">Create Room</span></a> }
      <a href="/History" class="@On("/History")">🎮 <span class="lbl">My Games</span></a>
      @if (User.IsInRole("Admin")) { <a href="/Admin" class="@(path == "/Admin" ? "on" : "")">🛡️ <span class="lbl">Hosts &amp; Employees</span></a><a href="/Admin/Reports" class="@On("/Admin/Reports")">📊 <span class="lbl">Reports</span></a><a href="/Admin/Sound" class="@On("/Admin/Sound")">🔊 <span class="lbl">Sound</span></a> }
      <a href="/Help" class="@On("/Help")">❓ <span class="lbl">Help</span></a>
    </nav>
  }
  <div class="who">
    @if (isAuth)
    {
      <span class="userpill">👤 @User.Identity!.Name</span>
      @if (User.IsInRole("Admin")) { <span class="badge bad">Admin</span> }
      @if (User.IsInRole("Host")) { <span class="badge brand">Host</span> }
      @if (appOpt.IsDev)
      { <a class="btn sm" href="/Dev/Login">Switch user (dev)</a> }
      @if (appOpt.IsManual)
      {
        <a class="btn" href="/Account/ChangePassword">🔒 <span class="lbl">Password</span></a>
        @* asp-page (not a plain action=) so the form tag helper adds the anti-forgery token the POST requires *@
        <form method="post" asp-page="/Account/ChangePassword" asp-page-handler="Logout" style="display:inline"><button class="btn" type="submit">↪ <span class="lbl">Sign out</span></button></form>
      }
    }
    @if (snd.AllowMute) { <button class="btn sm" id="soundBtn" title="Sound on/off" type="button">🔊</button> }
    <button class="btn sm" id="themeBtn" title="Toggle theme" type="button">🌓</button>
  </div>
</header>
<div class="deco" style="width:120px;height:120px;font-size:44px;left:-14px;bottom:-14px;--c:#d946ef;--d:#6b1d85">23</div>
<div class="deco" style="width:120px;height:120px;font-size:44px;left:210px;bottom:-34px;--c:#2f8bff;--d:#0a3fa8">7</div>
<div class="deco" style="width:96px;height:96px;font-size:36px;right:130px;bottom:-10px;--c:#22c55e;--d:#0d6b2e">46</div>
<div class="deco" style="width:100px;height:100px;font-size:38px;right:-22px;bottom:-30px;--c:#f5b301;--d:#9a6200">17</div>
<main class="@(ViewData["Narrow"] is true ? "narrow" : "") @(ViewData["Wide"] is true ? "wide" : "")">
  @RenderBody()
</main>
<script src="~/lib/jquery.min.js"></script>
<script src="~/lib/signalr.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
